{
  "name": "transportes-samu",
  "private": true,
  "version": "0.0.0",
  "description": "Dashboard de Transportes SAMU/CRU — painel operacional para regulação de transportes inter-unidades",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @samu-cru/web dev",
    "dev:ingest": "pnpm --filter @samu-cru/ingest dev",
    "build": "pnpm -r --filter=./apps/* --filter=./packages/* build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @samu-cru/db generate",
    "db:migrate": "pnpm --filter @samu-cru/db migrate",
    "db:studio": "pnpm --filter @samu-cru/db studio",
    "test": "pnpm -r --if-present test",
    "setup:db": "bash scripts/setup-db.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
