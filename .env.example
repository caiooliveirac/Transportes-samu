# ─── Postgres ────────────────────────────────────────────────────────────────
# Local dev (Homebrew, role samu_cru, trust auth). Run `pnpm setup:db` once.
DATABASE_URL=postgres://samu_cru@localhost:5432/samu_cru_dev

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
# Chave HS256 que assina o cookie de sessão (jose). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mínimo 32 chars. Trocá-la em prod desloga todo mundo.
AUTH_SECRET=dev-only-secret-please-change-me-32+chars
# Reguladores e admins agora são usuários nominais na tabela `users`,
# criados via `pnpm db:seed:users` (imprime senhas em claro pra anotar).
# Não usar mais ADMIN_PASSWORD único.

# ─── Ingest (apps/ingest) ────────────────────────────────────────────────────
# WORKER_ID identifica a linha em worker_heartbeat. Use um nome único por
# instância em produção (ex: "ec2-prod-1"). Default local: "local-dev".
WORKER_ID=local-dev
# O worker NÃO abre sessão WhatsApp. Ele recebe webhooks do gateway
# whatsmeow (container `whatsmeow-gw` no magalu), que detém a sessão do
# número do chefe de plantão e é compartilhado com o Giro de Leitos.
# Porta do webhook (o gateway chega por host.docker.internal).
WA_WEBHOOK_PORT=3082
# Interface de bind. Tem que ser alcançável pelo CONTAINER do gateway, que
# chega por host.docker.internal (172.17.0.1) — 127.0.0.1 faz todo POST dar
# timeout. Não é exposição pública: o ufw do host libera só SSH/80/443.
WA_WEBHOOK_HOST=0.0.0.0
# Precisa ser igual ao `--webhook-secret` do gateway (default upstream: "secret").
# Vazio desliga a checagem de HMAC — só em teste local.
WA_WEBHOOK_SECRET=secret
# JIDs dos grupos que o worker observa, separados por vírgula.
# Vazio = modo descoberta (aceita TODOS os @g.us).
# Produção: grupo "UT APOIO".
WA_ALLOWED_CHATS=557181082189-1589997108@g.us
# DRY_RUN=true       # parseia e loga, mas não escreve no DB. Útil pra debugar parser sem sujar.
# LOG_LEVEL=debug    # default: info
