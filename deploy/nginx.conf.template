# /etc/nginx/sites-available/transportes.mnrs.com.br
#
# Reverse proxy para o Next.js do transportes-samu (PM2 :3005).
# SSE-friendly: buffering desligado em /api/stream pra eventos
# chegarem instantâneo no cliente (PLANNING §9 + nosso PR 8).
#
# Activate:
#   sudo ln -s /etc/nginx/sites-available/transportes.mnrs.com.br /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d transportes.mnrs.com.br

upstream transportes_upstream {
  server 127.0.0.1:3005;
  keepalive 32;
}

server {
  listen 80;
  listen [::]:80;
  server_name transportes.mnrs.com.br;

  # Let's Encrypt cert renewal
  location /.well-known/acme-challenge/ {
    root /var/www/letsencrypt;
  }

  # Tudo o resto redireciona pra HTTPS (certbot reescreve esse bloco
  # quando emitir cert; deixar aqui é só pra primeiro boot).
  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name transportes.mnrs.com.br;

  # ssl_certificate / ssl_certificate_key serão inseridos pelo certbot

  # ─── SSE — eventos instantâneos ───────────────────────────────────
  # /api/stream emite text/event-stream. nginx buffering quebra.
  location /api/stream {
    proxy_pass http://transportes_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_buffering        off;
    proxy_cache            off;
    proxy_read_timeout     24h;
    proxy_send_timeout     24h;
    chunked_transfer_encoding on;
  }

  # ─── App e demais /api/* ──────────────────────────────────────────
  location / {
    proxy_pass http://transportes_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Suporte a Next.js streaming / RSC
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";

    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }

  # Health endpoint sem cache
  location /api/health {
    proxy_pass http://transportes_upstream;
    proxy_buffering off;
    proxy_cache_bypass 1;
  }

  # Logs
  access_log /var/log/nginx/transportes.access.log;
  error_log  /var/log/nginx/transportes.error.log warn;
}
